{
  "name": "react-devtools-mcp",
  "version": "0.1.0",
  "description": "React DevTools functionality exposed as MCP tools for browser injection",
  "main": "dist/react-devtools-mcp.iife.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:prepend",
    "build:main": "VITE_ENTRY=main vite build",
    "build:prepend": "VITE_ENTRY=prepend vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "start": "npx tsx scripts/start.ts"
  },
  "devDependencies": {
    "@babel/types": "^7.24.0",
    "@playwright/test": "^1.58.0",
    "@types/babel__traverse": "^7.20.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "keywords": [
    "react",
    "devtools",
    "mcp",
    "debugging",
    "inspector"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "react-devtools-core": "^7.0.1"
  }
}
